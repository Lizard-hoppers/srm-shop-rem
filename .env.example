CRM_DB_PATH=./crm.sqlite3
CRM_SECRET_KEY=change-me-to-a-random-secret
CRM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Optional: staff group chat the bot posts new-repair cards to. Add the bot
# to the group as admin, send /chatid there, put the returned id here.
# Left empty, notifications are silently skipped.
CRM_STAFF_GROUP_CHAT_ID=
# Optional: forum topic (message_thread_id) inside that group for repair
# cards, e.g. a "Ремонт техники" topic. Omit to post to the General feed.
CRM_REPAIR_TOPIC_ID=
# Optional: separate plain group chat for all repair masters — repair cards
# post here too, in addition to CRM_REPAIR_TOPIC_ID above.
CRM_MASTERS_GROUP_CHAT_ID=
# Optional: enables "photo an invoice, get a draft приход" in the bot DM
# (bot/purchase_photo.py). Left empty, the bot just ignores photos sent by
# staff. Never commit a real key here — this file is the template, real
# values live only in .env on the server.
OPENAI_API_KEY=
# Optional override — defaults to gpt-4o-mini (cheap, vision-capable) if unset.
OPENAI_VISION_MODEL=
